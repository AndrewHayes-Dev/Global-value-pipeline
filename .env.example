# Global Value Pipeline — Environment Variables
# ============================================================
# SECURITY: Copy this to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── FMP API Key (same key as original pipeline) ─────────────
FMP_API_KEY=your_fmp_api_key_here

# ── Cloudflare Account ──────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ── R2 Write Credentials (generate a new API token in R2 settings) ─
GLOBAL_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
GLOBAL_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# ── R2 Bucket Name ──────────────────────────────────────────
GLOBAL_R2_BUCKET_NAME=global-investor-data
